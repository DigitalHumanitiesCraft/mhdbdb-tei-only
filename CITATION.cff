# Citation File Format (https://citation-file-format.github.io/)
#
# Hinweis: Dies ist ein konservativer Stub mit den definitiv zuständigen
# Maintainer-Entitäten. Die finale Autor*innen-Liste für das erste Zenodo-Release
# wird vor dem Release-Tag abgestimmt (siehe Issue #91).
# Das vollständige Register aller Mitwirkenden ist unten als identifiers-Eintrag
# (type: url) verlinkt: authority-files/contributors.xml

cff-version: 1.2.0

title: "Mittelhochdeutsche Begriffsdatenbank (MHDBDB) – TEI-XML Repository: Mittelhochdeutsche Texte mit semantischen Annotationen"
message: "Wenn Sie Daten oder Software aus diesem Repository verwenden, zitieren Sie bitte den Zenodo-DOI der jeweils aktuellen Version (Concept DOI) und – falls relevant – die konkrete Release-Version. Weitere Mitwirkende siehe contributors.xml: https://github.com/DigitalHumanitiesCraft/mhdbdb-tei-only/blob/main/authority-files/contributors.xml"
type: dataset

authors:
  - family-names: "Zeppezauer-Wachauer"
    given-names: "Katharina"
    affiliation: "Universität Salzburg, Fachbereich Germanistik"

license:
  - MIT
  - CC-BY-NC-SA-4.0
repository-code: "https://github.com/DigitalHumanitiesCraft/mhdbdb-tei-only"
url: "https://dhcraft.org/mhdbdb-tei-only/"

identifiers:
  - type: url
    value: "https://github.com/DigitalHumanitiesCraft/mhdbdb-tei-only/blob/main/authority-files/contributors.xml"
    description: "Vollständiges Register aller MHDBDB-Mitwirkenden (Gründer, Koordination, Haupteditor:innen und Editor:innen; 51 Personen + 2 Organisationen mit Rollen)"

keywords:
  - "MHDBDB"
  - "Middle High German"
  - "mittelhochdeutsch"
  - "TEI-XML"
  - "digital corpus"
  - "semantic annotation"
  - "authority files"
  - "digital humanities"
  - "medieval studies"
  - "Mediävistik"
