<?xml version="1.0" encoding="UTF-8"?>
<!-- Genres example: demonstrates taxonomy structure in genres.xml
     Validates against: tei_all.rng + mhdbdb-authority.rnc
     Genre IDs use UUID-hash format: genre_XXXXXXXX
     Terms can appear in de, en, fr, la -->
<TEI xmlns="http://www.tei-c.org/ns/1.0">
  <teiHeader>
    <fileDesc>
      <titleStmt><title>Genres Example</title></titleStmt>
      <publicationStmt><publisher>MHDBDB</publisher><date>2026</date></publicationStmt>
      <sourceDesc><p>Schema example</p></sourceDesc>
    </fileDesc>
    <encodingDesc>
      <classDecl>
        <taxonomy xml:id="mhdbdb-genres">
          <desc>MHDBDB genre taxonomy</desc>

          <!-- Genre with terms in 4 languages (de, en, fr, la) -->
          <category xml:id="genre_88b5cae2">
            <catDesc>
              <term xml:lang="de">Liebesroman und Abenteuerroman</term>
              <term xml:lang="de" type="alternative">Minneroman</term>
              <term xml:lang="en">Love Romance and Adventure Romance</term>
              <term xml:lang="fr">Roman d'amour</term>
              <term xml:lang="la">Narratio amoris</term>
              <ptr type="broader" target="#genre_72cae96a"/>
            </catDesc>
          </category>

          <!-- Parent genre -->
          <category xml:id="genre_72cae96a">
            <catDesc>
              <term xml:lang="de">Versroman</term>
              <term xml:lang="en">Verse Romance</term>
            </catDesc>
          </category>

          <!-- Genre without broader pointer (top-level) -->
          <category xml:id="genre_0a612f94">
            <catDesc>
              <term xml:lang="de">Minnelehre</term>
              <term xml:lang="de" type="alternative">Minneregel</term>
              <term xml:lang="de" type="alternative">Minnereflexion</term>
              <term xml:lang="en">Minne Doctrine</term>
            </catDesc>
          </category>

        </taxonomy>
      </classDecl>
    </encodingDesc>
  </teiHeader>
  <text>
    <body>
      <p>See encodingDesc for genre taxonomy.</p>
    </body>
  </text>
</TEI>
