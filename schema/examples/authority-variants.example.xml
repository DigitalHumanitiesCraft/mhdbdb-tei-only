<?xml version="1.0" encoding="UTF-8"?>
<!-- Variants example: demonstrates all element/attribute paths in variants.xml
     Validates against: tei_all.rng + mhdbdb-authority.rnc -->
<TEI xmlns="http://www.tei-c.org/ns/1.0">
  <teiHeader>
    <fileDesc>
      <!-- variants.xml has a respStmt (generated by build script) -->
      <titleStmt>
        <title>Variants Example</title>
        <respStmt>
          <resp>Extracted from</resp>
          <name>MHDBDB TEI Corpus (666 texts)</name>
        </respStmt>
      </titleStmt>
      <publicationStmt><publisher>MHDBDB</publisher><date>2026</date></publicationStmt>
      <sourceDesc><p>Automatically extracted attestations from corpus</p></sourceDesc>
    </fileDesc>
  </teiHeader>
  <text>
    <body>
      <div type="orthographicVariants">

        <!-- Entry with multiple orthographic forms, linked to lemma -->
        <entry corresp="lexicon.xml#lemma_1">
          <form xml:id="type_1">minne</form>
          <form xml:id="type_2">mynne</form>
          <form xml:id="type_3">minn</form>
        </entry>

        <!-- Entry with single form -->
        <entry corresp="lexicon.xml#lemma_2">
          <form xml:id="type_4">a</form>
        </entry>

      </div>
    </body>
  </text>
</TEI>
