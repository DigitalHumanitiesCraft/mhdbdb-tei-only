<?xml version="1.0" encoding="UTF-8"?>
<!-- Namen-Beispiel: zeigt Taxonomie-Struktur in names.xml
     Validiert gegen: tei_all.rng + mhdbdb-authority.rnc
     IDs nutzen 8-stelliges hierarchisches Format: name_NNNNNNNN
     Besonderheit: enthält Cross-File-Zeiger auf concepts.xml (closeMatch, exactMatch) -->
<TEI xmlns="http://www.tei-c.org/ns/1.0">
  <teiHeader>
    <fileDesc>
      <titleStmt><title>Names Example</title></titleStmt>
      <publicationStmt><publisher>MHDBDB</publisher><date>2026</date></publicationStmt>
      <sourceDesc><p>Schema example</p></sourceDesc>
    </fileDesc>
    <encodingDesc>
      <classDecl>
        <taxonomy xml:id="mhdbdb-names">
          <desc>Onomastisches System der MHDBDB</desc>

          <!-- Top-Level-Kategorie -->
          <category xml:id="name_40000000">
            <catDesc>
              <term xml:lang="de">Eigennamen</term>
              <term xml:lang="en">Proper Names</term>
            </catDesc>
          </category>

          <!-- Unterkategorie mit broader-Zeiger (intern) -->
          <category xml:id="name_41000000">
            <catDesc>
              <term xml:lang="de">Personennamen</term>
              <term xml:lang="en">Personal Names</term>
              <ptr type="broader" target="#name_40000000"/>
            </catDesc>
          </category>

          <!-- Kategorie mit Cross-File-Zeigern auf concepts.xml -->
          <category xml:id="name_41100000">
            <catDesc>
              <term xml:lang="de">Vornamen</term>
              <term xml:lang="en">First Names</term>
              <ptr type="broader" target="#name_41000000"/>
              <!-- exactMatch: diese Namens-Kategorie entspricht einem Konzept -->
              <ptr type="exactMatch" target="concepts.xml#concept_11100000"/>
            </catDesc>
          </category>

          <!-- Kategorie mit closeMatch (näherungsweise Entsprechung) -->
          <category xml:id="name_41200000">
            <catDesc>
              <term xml:lang="de">Familiennamen</term>
              <term xml:lang="en">Family Names</term>
              <ptr type="broader" target="#name_41000000"/>
              <ptr type="closeMatch" target="concepts.xml#concept_11200000"/>
            </catDesc>
          </category>

        </taxonomy>
      </classDecl>
    </encodingDesc>
  </teiHeader>
  <text>
    <body>
      <p>See encodingDesc for name taxonomy.</p>
    </body>
  </text>
</TEI>
