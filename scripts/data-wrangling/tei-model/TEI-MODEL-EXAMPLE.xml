  │ @wordRef     │ @corresp (migrieren)    │ Standard (att.global)    │
  │ @xml:id      │ @xml:id (behalten)      │ Standard (att.global)    │
  └──────────────┴─────────────────────────┴──────────────────────────┘

  INTERPUNKTION:
  ┌──────────────────────────┬──────────────────────────┐
  │ IST                      │ SOLL                     │
  ├──────────────────────────┼──────────────────────────┤
  │ <seg type="pc">.</seg>   │ <pc join="left">.</pc>   │
  │ (kein @pos moeglich)     │ (@pos, @lemma moeglich)  │
  └──────────────────────────┴──────────────────────────┘

  HERVORHEBUNGEN:
  ┌──────────────────────────┬──────────────────────────┐
  │ IST                      │ IDEELL (optional)        │
  ├──────────────────────────┼──────────────────────────┤
  │ <hi rend="initial">      │ <hi rendition="#in">     │
