\par \tab \tab \tab \tab Und leschet allez tr\'fbren an der selben stunt,
\par \tab \tab \tab \tab s\'f4 liebl\'eech lachet in liebe ir s\'fcezer r\'f4ter munt,
\par \tab \tab \tab 10\tab und str\'e2le \'fbz spilnden ougen schiezent in mannes herzen grunt.
\par 
\par 
\par \tab }{\b\f41\fs24 VI}{\f41\fs24 \tab \tab \tab Vil s\'fceziu frowe h\'f4hgelopt mit reiner g\'fcete,\tab 27,27
\par \tab \tab \tab \tab d\'een kiuscher l\'eep g\'eet }{\f41\fs24\ul w\'fcnne}{\f41\fs24 berndez h\'f4hgem\'fcete,
\par \tab \tab \tab \tab d\'een munt ist roeter danne ein liehte r\'f4se in touwes bl\'fcete.
\par \tab \tab \tab \tab Got h\'e2t gehoehet und geh\'earet reine frowen,
\par \tab \tab \tab 5\tab daz man in wol sprechen <}{\f41\fs24\ul sol}{\f41\fs24 > und dienen zaller z\'eet.
\par \tab \tab \tab \tab der werlde hort mit wunneklichen vreuden }{\f41\fs24\ul l}{\f41\fs24 \'eet
\par \tab \tab \tab \tab an in, ir lop ist l\'fbter unde cl\'e2r, man sol sie schowen.
\par \tab \tab \tab \tab F\'fcr tr\'fbren und f\'fcr ungem\'fcete ist niht s\'f4 guot,
\par \tab \tab \tab \tab als an ze sehen ein schoene frowe wol gemuot,
\par \tab \tab \tab 10\tab swenne s\'ee \'fbz her}{\f41\fs24\ul z}{\f41\fs24 en grunde ir friunde ein lieblich lachen tuot.
\par 
\par 
\par \tab }{\b\f41\fs24 VII}{\f41\fs24 \tab \tab \tab Von R\'f4me voget, von P\'fclle k\'fcnic, l\'e2t iuch erbarmen,\tab 28,1
\par \tab \tab \tab \tab daz man b\'ee r\'eecher kunst mich l\'e2t alsus armen.
\par \tab \tab \tab \tab gerne wolde ich, m\'f6hte ez s\'een, b\'ee eigenem fiur erwarmen.
\par \tab \tab \tab \tab Ah\'ee, wie ich danne sunge von den vogell\'eenen,
\par \tab \tab \tab 5\tab von der heide und von den bluomen, als ich w\'eelent sanc!
\par \tab \tab \tab \tab swelch schoene w\'eep mir g\'e6be danne ir habedanc,
\par \tab \tab \tab \tab der lieze ich liljen unde r\'f4sen \'fbz ir wengel sch\'eenen.
\par \tab \tab \tab \tab Kume ich sp\'e2te und r\'eete fruo, gast, w\'ea dir, w\'ea!
\par \tab \tab \tab \tab s\'f4 mac der wirt wol singen von dem gr\'fcenen kl\'ea.
\par \tab \tab \tab 10\tab die n\'f4t bedenkent, milter k\'fcnic, daz iuwer n\'f4t zerg\'ea!
\par 
\par 
\par \tab }{\b\f41\fs24 VIII}{\f41\fs24 \tab \tab \tab Herzoge \'fbz Oesterr\'eeche, ez ist iu wol ergangen\tab 28,11
\par \tab \tab \tab \tab und als\'f4 sch\'f4ne, daz uns muoz n\'e2ch iu belangen.
\par \tab \tab \tab \tab s\'eet gewis, swenne ir uns komet, ir werdent }{\f41\fs24\ul h}{\f41\fs24 \'f4ch enpfangen.
\par \tab \tab \tab \tab Ir s\'eet wol wert, daz wir die gloggen g\'ean iu liuten,
\par \tab \tab \tab 5\tab dringen unde schouwen, als ein wunder komen s\'ee.
\par \tab \tab \tab \tab ir komet uns beide s\'fcnden unde schanden vr\'ee,
\par \tab \tab \tab \tab des suln wir man iuch loben, und die frowen suln iuch triuten.
\par \tab \tab \tab \tab Diz liehte lop wol f\'fceget heime unz \'fbf daz ort;
\par \tab \tab \tab \tab s\'eet uns hie biderbe f\'fcr daz ungef\'fcegte wort,
\par \tab \tab \tab 10\tab daz ieman spreche, ir soldet s\'een beliben mit \'earen dort.
\par 
\par 
\par \tab }{\b\f41\fs24 IX}{\f41\fs24 \tab \tab \tab Er schalk, in }{\f41\fs24\ul s}{\f41\fs24 welchem leben er s\'ee, der dankes triege\tab 28,21
\par \tab \tab \tab \tab unde s\'eenen h\'earren l\'eare, daz er liege!
\par \tab \tab \tab \tab erlamen m\'fcezen im diu bein, als er sich zuo dem r\'e2te biege!
\par \tab \tab \tab \tab S\'ee aber er s\'f4 h\'ear, daz er d\'e2 zuo sitze,
\par \tab \tab \tab 5\tab s\'f4 w\'fcnsche ich, daz s\'een ungetriuwe zunge m\'fceze erlamen.
\par \tab \tab \tab \tab die selben machent uns die biderben \'e2ne schamen.
\par \tab \tab \tab \tab sol liegen witze s\'een, s\'f4 pflegent si tugendel\'f4ser witze.
\par \tab \tab \tab \tab M\'f6hten sie in r\'e2ten, daz si liezen in irme kragen
\par \tab \tab \tab \tab ir valsche gel\'fcbde oder n\'e2ch gel\'fcbde <}{\f41\fs24\ul niht}{\f41\fs24 > versagen?
\par \tab \tab \tab 10\tab si solten geben, \'ea dem lobe der k}{\f41\fs24\ul alc}{\f41\fs24  w\'fcrde abe getragen.
\par 
\par 
\par \tab }{\b\f41\fs24 X}{\f41\fs24 \tab \tab \tab Ich h\'e2n m\'een l\'eahen, al die werlt, ich h\'e2n m\'een l\'eahen!\tab 28,31
\par \tab \tab \tab \tab n\'fb enf\'fcrhte ich niht den hornunc an die z\'eahen
\par \tab \tab \tab \tab und wil alle boese h\'earren dester minre vl\'eahen.
\par \tab \tab \tab \tab Der edel k\'fcnic, der milte k\'fcnic h\'e2t mich ber\'e2ten,
\par \tab \tab \tab 5\tab daz ich den sumer luft und in dem winter hitze h\'e2n.
\par \tab \tab \tab \tab m\'eenen n\'e2hgeb\'fbren dunke ich verre baz get\'e2n;
\par \tab \tab \tab \tab si sehent mich niht m\'ear an in butzen w\'ees, als si w\'eelent t\'e2ten.
\par \tab \tab \tab \tab Ich bin ze lange arn gewesen \'e2}{\f41\fs24\ul n}{\f41\fs24  m\'eenen danc,\tab 29,1
\par \tab \tab \tab \tab ich was s\'f4 volle scheltens, daz m\'een \'e2ten stanc,
\par \tab \tab \tab 10\tab daz h\'e2t der k\'fcnic gemachet reine und dar zuo m\'eenen sanc.
\par 
\par 
\par \tab }{\b\f41\fs24 XI}{\f41\fs24 \tab \tab \tab Ir f\'fcrsten, die des k\'fcniges gerne w\'e6re}{\f41\fs24\ul n}{\f41\fs24  \'e2ne,\tab 29,15
\par \tab \tab \tab \tab die volgen m\'eeme r\'e2te; ich enr\'e2te in niht n\'e2ch w\'e2ne.
\par \tab \tab \tab \tab welt ir, ich schicke in t\'fbsent m\'eele und dannoch m\'ea f\'fcr Tr\'e2ne.
\par \tab \tab \tab \tab Der helt wil Kristes reise varn; swer in des irret,
\par \tab \tab \tab 5\tab der h\'e2t wider got und al die kristenheit get\'e2n.
\par \tab \tab \tab \tab ir v\'eeende, ir sult in s\'eene str\'e2ze varn l\'e2n.
\par \tab \tab \tab \tab waz ob er hie heime iu niemer m\'ea niht gewirret?
\par \tab \tab \tab \tab Bel\'eebe er dort, des got niht gebe, s\'f4 lachent ir;
\par \tab \tab \tab \tab kome er uns friunden wider hein, s\'f4 lachen wir.
\par \tab \tab \tab 10\tab der m\'e6re warten beidenthalp, und h\'e2nt den r\'e2t von mir.
\par 
\par 
\par \tab }{\b\f41\fs24 XII}{\f41\fs24 \tab \tab \tab Got weiz wol, m\'een lop w\'e6re iemer }{\f41\fs24\ul hove}{\f41\fs24 st\'e6te,\tab 30,9
\par \tab \tab \tab \tab d\'e2 man eteswenne lobel\'eeche t\'e6te
\par \tab \tab \tab \tab mit geb\'e6rde, mit gewisser rede, mit r\'e6te.
\par \tab \tab \tab \tab Mich griulet, s\'f4 mich lachent an die lech}{\f41\fs24\ul el}{\f41\fs24 \'e6re,
\par \tab \tab \tab 5\tab den diu zunge honeget und daz herze gallen h\'e2t.
\par \tab \tab \tab \tab friundes lachen sol s\'een \'e2ne misset\'e2t,
\par \tab \tab \tab \tab s\'fceze als der \'e2bentr\'f4t, der k\'fcndet l\'fbter m\'e6re.
\par \tab \tab \tab \tab N\'fb tuo mir lachel\'eech}{\f41\fs24\ul e}{\f41\fs24  oder lache aber andersw\'e2.
\par \tab \tab \tab \tab swes munt mich triegen wil, der habe s\'een lachen d\'e2,
\par \tab \tab \tab 10\tab von dem n\'e6me ich ein w\'e2rez nein f\'fcr zwei gelogeniu j\'e2.
\par 
\par 
\par \tab }{\b\f41\fs24 XIII}{\f41\fs24 \tab \tab \tab Die w\'eesen r\'e2tent, swer ze himelr\'eeche welle,\tab 26,13
\par \tab \tab \tab \tab daz er vil wol bewarte unde ouch bestelle
\par \tab \tab \tab \tab den wec, daz iemen dar \'fbffe habe, der in her wider velle.
\par \tab \tab \tab \tab Ein \'e6chter heizet mort, der sch\'e2t der str\'e2ze s\'eare;
\par \tab \tab 5\tab d\'e2 b\'ee vert einer in starken bennen, der ist geheizen brant;
\par \tab \tab \tab \tab s\'f4 sprechent sie einem wuocher, der h\'e2t gar geschant
\par \tab \tab \tab \tab die selben str\'e2ze. dannoch ist der wegewerender m\'eare:
\par \tab \tab \tab \tab N\'ee}{\f41\fs24\ul t}{\f41\fs24  unde haz die h\'e2nt sich \'fbf den wec geleit
\par \tab \tab \tab \tab und diu verschampt unm\'e2ze g\'eetekeit.
\par  \tab \tab \tab 10\tab dannoch s\'f4 rennet maniger f\'fcr, des ich niht h\'e2n geseit.
\par 
\par 
\par \tab }{\b\f41\fs24 XIV}{\f41\fs24 \tab \tab \tab Ich trunke gerne, d\'e2 man b\'ee der m\'e2ze schenket\tab 29,25
\par \tab \tab \tab \tab unde der unm\'e2ze niemen iht gedenket,
\par \tab \tab \tab \tab s\'eet s\'ee den man an l\'eeb, an guot und an den \'earen krenket.
\par \tab \tab \tab \tab Si sch\'e2t ouch an der s\'eale, hoere ich \'aejehen die w\'eesen\'ac.
\par \tab \tab \tab 5\tab des m\'f6ht ein ieglich man von s\'eenem wirte wol enbern.
\par \tab \tab \tab \tab liez er sich vollecl\'eeche b\'ee der m\'e2ze wern,
\par \tab \tab \tab \tab s\'f4 m\'f6hte ime gel\'fccke, heil und s\'e6lde und \'eare \'fbf r\'eesen.
\par \tab \tab \tab \tab Diu m\'e2ze wart den liuten darumbe \'fbf geleit,
\par \tab \tab \tab \tab daz man si ebene m}{\f41\fs24\ul \'e6z}{\f41\fs24 e <}{\f41\fs24\ul und tr\'fcege}{\f41\fs24 >, ist mir geseit.
\par \tab \tab \tab 10\tab n\'fb hab er dank, der si ebene mezze und der si ebene treit.
\par 
\par 
\par \tab }{\b\f41\fs24 XV}{\f41\fs24 \tab \tab \tab Er h\'e2t niht wol getrunken, der sich \'fcbertrinket.\tab 29,35
\par \tab \tab \tab \tab wie zimet [ ] einem biderben man, daz [ ] diu zunge hinket
\par \tab \tab \tab \tab von w\'eene? ich w\'e6ne, er houbets\'fcnde und schande zuo im winket.\tab 30,1
\par \tab \tab \tab \tab Im z\'e6me baz, m\'f6hte er gebr\'fbchen s\'eene f\'fceze,
\par \tab \tab \tab 5\tab daz er \'e2ne helfe b\'ee den liuten m\'f6hte st\'e2n.
\par \tab \tab \tab \tab swie sanfte man in tr\'fcege, er m\'f6hte lieber g\'e2n.
\par \tab \tab \tab \tab sus trinke ein iegesl\'eecher man, daz er den durst geb\'fceze;
\par \tab \tab \tab \tab Daz tuot er \'e2ne houbets\'fcnde und \'e2ne spot.
\par \tab \tab \tab \tab swelc}{\f41\fs24\ul h}{\f41\fs24  man getrinket, daz er sich noch got
\par \tab \tab \tab 10\tab erkennet, s\'f4 h}{\f41\fs24\ul \'e2}{\f41\fs24 t er gebrochen ime s\'een h\'f4ch gebot.
\par 
\par 
\par \tab }{\b\f41\fs24 XVI}{\f41\fs24 \tab \tab \tab S\'eet got ein rehter rihter heizet an den buochen,\tab 30,19
\par \tab \tab \tab \tab der solt \'fbz s\'eener milte des geruochen,
\par \tab \tab \tab \tab daz er die gar getriuwen \'fbz den valschen hieze suochen.
\par \tab \tab \tab \tab Joch meine ich hie, sie werdent dort vil gar gesundert;
\par \tab \tab \tab 5\tab doch s\'e6he ich an ir ettesl\'eechem gerne ein schanden m\'e2l.
\par \tab \tab \tab \tab der sich dem man windet \'fbz der hant reht als ein \'e2}{\f41\fs24\ul l}{\f41\fs24 ,
\par \tab \tab \tab \tab ow\'ea, daz got niht zornecl\'eechen s\'eare an deme wundert!
\par \tab \tab \tab \tab Swer sant mir var von h\'fbse, der var ouch mit mir hein.
\par \tab \tab \tab \tab des mannes muot sol veste s\'een als ein stein,
\par \tab \tab \tab 10\tab \'fbf triuwe sleht unde eben als ein vil wol gemahter zein.
\par 
\par 
\par \tab }{\b\f41\fs24 XVII}{\f41\fs24 \tab \tab \tab Sw\'e2 n\'fb zuo hove dienet der h\'earre s\'eeme knechte\tab XXIX,1 [!]
\par \tab \tab \tab \tab unde sw\'e2 der valke vor dem raben st\'eat zuo rechte,
\par \tab \tab \tab \tab d\'e2 sp\'fcrt man offenl\'eech unart, unadel unde ungeslechte.
\par \tab \tab \tab \tab D\'fb werde ritterschaft, d\'een dinc st\'eat j\'e2merl\'eeche,
\par \tab \tab \tab 5\tab sw\'e2 der sester vor dem schilde hin zuo hove vert.
\par \tab \tab \tab \tab vrou Ere, d\'e2 sint iuwe}{\f41\fs24\ul r}{\f41\fs24  snellen spr\'fcnge erwert.
\par \tab \tab \tab \tab wol \'fbf mit mir, und vare wir d\'e2 heim in Osterr\'eeche!
\par \tab \tab \tab \tab D\'e2 vinde wir de}{\f41\fs24\ul n}{\f41\fs24  v\'fcrsten wert, der ist iu holt,
\par \tab \tab \tab \tab wolt ir mich d\'e2 zuo hove leiten, als\'f4 ir solt,
\par \tab \tab \tab 10\tab s\'f4 wirt geh\'f4het wol d\'een name von mir, werder Liupolt.
\par 
\par 
\par \tab }{\b\f41\fs24 XVIII}{\f41\fs24 \tab \tab \tab Swelich man sich gerne vr\'eejen wil von boeser sache,\tab XXX,1
\par \tab \tab \tab \tab dem r\'e2t ich, daz er s\'eene tugent wol bewache
\par \tab \tab \tab \tab und vlie ouch die gesezzen s\'een under schanden dache.
\par \tab \tab \tab \tab Weiz got, tuot er des niht, s\'f4 mac im misselingen
\par \tab \tab \tab 5\tab an \'earen unde an wirdicheit. swelich man gerne \'eare h\'e2t,
\par \tab \tab \tab \tab der sol sich machen vr\'ee von aller misset\'e2t
\par \tab \tab \tab \tab <. . . . . . . . . . . . . .> 
\par \tab \tab \tab \tab Er ist zuo der werlde ein s\'e6lic man, den s\'f4 s\'een muot
\par \tab \tab \tab \tab getiuret h\'e2t, daz er daz beste gerne tuot
\par \tab \tab \tab 10\tab und sich der schanden h\'e2t bewegen: der mac wol heizen guot.
\par 
\par 
\par }{\b\f41\fs24 \tab XIX}{\f41\fs24 \tab \tab \tab Swer sich des st\'e6ten friundes durch \'fcbermuot beh\'earet\tab 30,29
\par \tab \tab \tab \tab und er den s\'eenen durch des fr\'f6mden \'eare un\'earet,
\par \tab \tab \tab \tab der m\'f6hte ersehen, wurde er von s\'eenem hoehern ouch ges\'earet,
\par \tab \tab \tab \tab Daz diu gehalsen friuntschaft sich vil l\'eehte entrande,
\par \tab \tab \tab 5\tab swenne er sich l\'eebes unde guotes solde umb in bewegen.
\par \tab \tab \tab \tab wir h\'e2n vereischet, die der wenke h\'e2nt gepflegen,
\par \tab \tab \tab \tab daz s\'ee der kumber wider \'fbf die erborne friunde wande.
\par \tab \tab \tab \tab Daz sol n\'e2ch gotes l\'eahen dicke noch geschehen.
\par \tab \tab \tab \tab ouch h\'f4rte ich die liute des mit volge jehen,\tab 31,1
\par \tab \tab \tab 10\tab gewissen friunt, versuohte swert sul man ze noeten sehen.
\par 
\par 
\par }{\b\f41\fs24 \tab XX}{\f41\fs24 \tab \tab \tab Ich wil niht m\'ea den ougen volgen noch den sinnen.\tab 31,3
\par \tab \tab \tab \tab diu rieten mir an zwei, daz ich diu solde minnen,
\par \tab \tab \tab \tab diu w\'e2ren \'e2ne valsch geworht beidiu \'fbzen und och innen.
\par \tab \tab \tab \tab D\'e2 wart ein w\'eanec in geleit, daz was niht st\'e6te,
\par \tab \tab \tab 5\tab des vielten sich ir egge, d\'f4 si solten h\'e2n gesniten.
\par \tab \tab \tab \tab und w\'e6re eht niht wan daz alleine drinne vermiten,
\par \tab \tab \tab \tab s\'f4 w\'e6ren si allenthalben alse ganz an ir get\'e6te,
\par \tab \tab \tab \tab Daz sich ein iegesl\'eecher mohte l\'e2zen dran.\tab 
\par \tab \tab \tab \tab ow\'ea, daz ich der tr\'fcge ie kunde an in ge}{\f41\fs24\ul w}{\f41\fs24 an!
\par \tab \tab \tab 10\tab wie \'fcbel ich mich des schaden <}{\f41\fs24\ul fr\'f6uwe}{\f41\fs24 > und in des lasters gan!
\par 
\par 
\par }\pard \qc \li0\ri0\widctlpar\tx-2160\tx-1440\tx-720\tx0\tqr\tx720\tx1152\tqr\tx1296\tx1728\tqr\tx10800\faauto\rin0\lin0\itap0 {\f41\fs24 *
\par }\pard \qj \li0\ri0\widctlpar\tx-2160\tx-1440\tx-720\tx0\tqr\tx720\tx1152\tqr\tx1296\tx1728\tqr\tx10800\faauto\rin0\lin0\itap0 {\f41\fs24 
\par \tab \tab \tab \tab }{\f41\fs24\ul Eine Kontrafakturstrophe zu VII in B:}{\f41\fs24 
\par 
\par \tab }{\b\f41\fs24 XXI}{\f41\fs24 \tab \tab \tab Der welte vogt, des himels k\'fcnig, ich lob iuch gerne,\tab 153,1
\par \tab \tab \tab \tab daz ir mich h\'e2nt erl\'e2n, daz ich niht lerne,
\par \tab \tab \tab \tab als dirre und der an vr\'f6mder stat mit s\'eenem gesange scherne.
\par \tab \tab \tab \tab M\'een meister claget s\'f4 s\'eare von der Vogelweide,
\par \tab \tab 5\tab in twinge diz, in twinge daz, daz mich noch nie ge}{\f41\fs24\ul t}{\f41\fs24 wanc.
\par \tab \tab \tab \tab daz machet, daz ich mich s\'f4 k\'fbme von dem m\'eenem scheide,
\par \tab \tab \tab \tab mir geben danne h\'f4he herren und ein schoenez w\'eep ir habedanc.
\par \tab \tab \tab \tab Sus r\'eete ich sp\'e2te und kume doch hein; mir ist niht ze w\'ea
\par \tab \tab \tab \tab und singe ouch von der heide und von deme gr\'fcenen cl\'ea.
\par \tab \tab \tab 10\tab daz st\'e6tent ir mir, milter got, daz ez mir iht zerg\'ea.
\par 
\par 
