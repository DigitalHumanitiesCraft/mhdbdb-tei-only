\par }\pard \ql \li0\ri0\widctlpar\tx-2154\tx-1434\tx-714\tx6\tqr\tx726\tx1158\tqr\tx1302\tx1734\tqr\tx10806\faauto\rin0\lin0\itap0 {\f41\fs24 d\'fbn s\'eest niht dankes milte. des bedunket mich,
\par wie d\'fb d\'e2 mite verliesest michels m\'eare.
\par d\'fb m\'f6htest gerner dankes geben t\'fbsent pfunt
\par 5danne dr\'eezec t\'fbsent \'e2ne danc. dir ist niht kunt,
