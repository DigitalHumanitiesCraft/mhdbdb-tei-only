\par }{\b\f41\fs24 I}{\f41\fs24 \tab \tab R\'eet ze hove, Dietrich!\tab 82,11
\par \tab \tab \'bbh\'earre, in mac.\'ab waz irret dich?
\par \tab \tab \'bbin h\'e2n niht rosses, daz ich dar ger\'eete.\'ab
\par \tab \tab ich l\'eehe dir einz, und wilt d\'fb daz.
\par \tab 5\tab \'bbh\'earre, ger\'eete al deste baz.\'ab
\par \tab \tab n\'fb stant als\'f4, noch ein w\'eele b\'eete!
\par \tab \tab Weder ritest gerner eine guld\'een katzen,
\par \tab \tab alder einen wunderl\'eechen G\'earhart Atzen?
\par \tab \tab \'bbsemir got, und \'e6ze ez h\'f6i, ez w\'e6r ein fr\'f6mdez pfert.
\par \tab 10\tab im g\'eant diu ougen umbe als einem affen,
\par \tab \tab er ist als ein guggaldei geschaffen.
\par \tab \tab den selben Atzen gebent mir her, s\'f4 bin ich wol gewert.\'ab
\par \tab \tab n\'fb kr\'fcmbe d\'een bein, r\'eet selbe her hein, s\'eet du Atzen h\'e2st gegert.
\par 
\par 
\par }{\b\f41\fs24 II}{\f41\fs24 \tab \tab Ow\'ea, daz w\'eesheit unde jugent,\tab 82,24
\par \tab \tab des mannes schoene noch s\'een tugent
\par \tab \tab niht erben sol, s\'f4 ie der l\'eep erstirbet!
\par \tab \tab daz mac wol clagen ein w\'eeser man,
\par \tab 5\tab der sich des schaden versinnen kan,
\par \tab \tab Reim\'e2r, waz guoter kunst an dir verdirbet.
\par \tab \tab D\'fb solt von schulden iemer des geniezen,
\par \tab \tab daz dich des tages nie wolte verdriezen,
\par \tab \tab dun spr\'e6ches ie den vrowen wol <. . . . . . .>
\par \tab 10\tab des s\'fcln si iemer danken d\'eener zungen.
\par \tab \tab und hetest }{\f41\fs24\super '}{\f41\fs24 anders niht wan eine rede gesungen -
\par \tab \tab s\'f4 wol dir, w\'eep, wie reine }{\f41\fs24\ul ein}{\f41\fs24  nam! - d\'fb hetest \'aealse gestriten
\par \tab \tab an ir lop\'ac, daz elliu w\'eep dir iemer gn\'e2den solten biten.
\par 
\par 
\par }{\b\f41\fs24 III}{\f41\fs24 \tab \tab D\'east w\'e2r, Reim\'e2r, d\'fb riuwest mich\tab 83,1
\par \tab \tab michels harter danne ich dich,
\par \tab \tab ob d\'fb lebtest und ich w\'e6r erstorben.
\par \tab \tab ich wil ez b\'ee m\'eenen triuwen sagen,
\par \tab 5\tab dich selben wolt ich l\'fctzel klagen:
\par \tab \tab ich klage d\'een edelen kunst, daz si ist verdorben.
\par \tab \tab D\'fb kundest al der werlte fr\'f6ide m\'earen,
\par \tab \tab s\'f4 d\'fb ez ze guoten dingen woltes k\'earen.
\par \tab \tab mich riuwet d\'een wol redender munt und d\'een vil s\'fcezer sanc,
\par \tab 10\tab daz die verdorben sint b\'ee m\'eenen z\'eeten.
\par \tab \tab daz d\'fb niht eine w\'eele mohtest b\'eeten!
\par \tab \tab s\'f4 leist ich dir geselleschaft, m\'een singen ist niht lanc.
\par \tab \tab d\'een s\'eale m\'fceze wol gevarn, und habe d\'een zunge danc!
\par 
\par 
\par }{\b\f41\fs24 IV}{\f41\fs24 \tab \tab Sw\'e2 der h\'f4he nider g\'e2t\tab 83,14
