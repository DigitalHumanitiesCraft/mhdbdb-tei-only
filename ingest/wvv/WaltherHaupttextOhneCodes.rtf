\par \tab \tab \tab \tab und ir boese}{\f41\fs24\ul n}{\f41\fs24  boeser machent,
\par \tab \tab \tab \tab \'e2n erben m\'fcezen s\'ee vervarn,
\par \tab \tab \tab \tab daz tugendel\'f4ser h\'earren iht werde m\'eare,
