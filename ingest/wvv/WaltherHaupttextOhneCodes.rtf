\par \tab \tab \tab 5\tab swer m\'een ze bruoder niht enwil,
\par \tab \tab \tab \tab der sprichet diu starken wort \'fbz krankem sinne.
\par \tab \tab \tab \tab Wir wahsen \'fbz gel\'eechem dinge.
\par \tab \tab \tab \tab sp\'eese frumet uns, diu wirt ringe,
\par \tab \tab \tab \tab s\'f4 si dur den munt gevert.
\par \tab \tab \tab 10\tab wer kan den h\'earren von dem knehte gescheiden,
\par \tab \tab \tab \tab sw}{\f41\fs24\ul \'e2}{\f41\fs24  }{\f41\fs24\ul er}{\f41\fs24  ir gebeine bl\'f4zez f\'fcnde,
\par \tab \tab \tab \tab het er ir joch lebender k\'fcnde,
\par \tab \tab \tab \tab s\'f4 gew\'fcrme daz fleisch verzert?
\par \tab \tab \tab \tab im dienent kristen, juden unde heiden,
\par \tab \tab \tab 15\tab der elliu lebendiu wunder nert.
\par 
\par 
\par \tab }{\b\f41\fs24 VI}{\f41\fs24 \tab \tab \tab Swer houbets\'fcnde und schande tuot\tab 22,18
\par \tab \tab \tab \tab mit s\'eener wizzende umbe guot,
\par \tab \tab \tab \tab sol man den f\'fcr einen w\'eesen nennen?
\par \tab \tab \tab \tab swer guot von disen beiden h\'e2t,
\par \tab \tab \tab 5\tab swerz an im weiz und sichs verst\'e2t,
\par \tab \tab \tab \tab der sol in zeinem t\'f4ren baz erkennen.
\par \tab \tab \tab \tab D}{\f41\fs24\ul er}{\f41\fs24  w\'ees}{\f41\fs24\ul e}{\f41\fs24  minn}{\f41\fs24\ul et}{\f41\fs24  niht s\'f4 s\'eare
\par \tab \tab \tab \tab alsam die gotes hulde und \'eare.
\par \tab \tab \tab \tab s\'een selbes l\'eep, w\'eep unde kint,
\par \tab \tab \tab 10\tab diu l\'e2t er, \'ea er disiu zwei verliese.
\par \tab \tab \tab \tab er t\'f4re, er dunket mich niht w\'eese,
\par \tab \tab \tab \tab und ouch der s\'een \'eare pr\'eese;
\par \tab \tab \tab \tab ich w\'e6ne, si beide t\'f4ren sint.
\par \tab \tab \tab \tab er gouch, swer f\'fcr diu zwei ein anderz kiese,
\par \tab \tab \tab 15\tab der ist an rehten witzen blint.
\par 
\par 
\par \tab }{\b\f41\fs24 VII}{\f41\fs24 \tab \tab \tab Junc man, in swelher aht d\'fb bist,\tab 22,33
\par \tab \tab \tab \tab ich wil dich l\'earen einen list:
\par \tab \tab \tab \tab d\'fb l\'e2 dir niht ze w\'ea s\'een n\'e2ch dem guote.
\par \tab \tab \tab \tab l\'e2 dirz ouch niht zunm\'e6re s\'een.
\par \tab \tab \tab 5\tab und volgest d\'fb der l\'eare m\'een,
\par \tab \tab \tab \tab s\'f4 wis gewis, ez frumt dir an dem muote.\tab 23,1
