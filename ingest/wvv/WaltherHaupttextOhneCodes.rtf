\par \tab \tab \tab 5\tab d\'e2 wir schapel br\'e2chen \'ea,
\par \tab \tab \tab \tab d\'e2 l\'eet n\'fb r\'eef unde sn\'ea,
\par \tab \tab \tab \tab daz tuot den vogell\'eenen w\'ea.
\par 
\par \tab III\tab \tab \tab Die t\'f4ren sprechent \'bbsn\'ee\'e2 sn\'ee\'ab,\tab 76,1
\par \tab \tab \tab \tab die armen liute \'bbow\'ea ow\'ee\'ab.
\par \tab \tab \tab \tab des bin ich sw\'e6r alsam ein bl\'ee,
\par \tab \tab \tab \tab der wintersorge h\'e2n ich dr\'ee.
\par \tab \tab \tab 5\tab swaz der under andern s\'ee,
\par \tab \tab \tab \tab der wurde ich alse schiere vr\'ee,
\par \tab \tab \tab \tab w\'e6r uns der sumer n\'e2he b\'ee.
\par \tab \tab 
\par \tab IV\tab \tab \tab E danne ich lange lebt als\'f4,\tab 76,8
\par \tab \tab \tab \tab den crebz wolte ich \'ea ezzen r\'f4.
\par \tab \tab \tab \tab sumer, mache uns aber vr\'f4,
\par \tab \tab \tab \tab d\'fb zierest anger unde l\'f4.
\par \tab \tab \tab 5\tab mit den bluomen spilt ich d\'f4,
\par \tab \tab \tab \tab m\'een herze swebt in sunnen h\'f4,
\par \tab \tab \tab \tab daz jaget der winter in ein str\'f4.
\par 
\par \tab V\tab \tab \tab Ich bin verlegen als ein s\'fb,\tab 76,15
\par \tab \tab \tab \tab m\'een sleht h\'e2r ist mir worden r\'fb.
\par \tab \tab \tab \tab s\'fcezer sumer, w\'e2 bist d\'fb?
\par \tab \tab \tab \tab j\'e2 s\'e6he ich gerner veltgeb\'fb,
\par \tab \tab \tab 5\tab danne ich lange in selcher dr\'fb,
\par \tab \tab \tab \tab beclemmet w\'e6re, als ich bin n\'fb:
\par \tab \tab \tab \tab ich wurde \'ea munich ze Toberl\'fb.
\par 
