\par \tab }{\b\f41\fs24 I}{\f41\fs24 \tab \tab \tab Vil s\'fceze w\'e6re minne,\tab 76,22
\par \tab \tab \tab \tab berihte kranke sinne.
\par \tab \tab \tab \tab got, durch d\'een anebeginne
\par \tab \tab \tab \tab bewar die kristenheit.
\par \tab \tab \tab 5\tab d\'een kunft ist fr\'f4neb\'e6re
\par \tab \tab \tab \tab \'fcber }{\f41\fs24\ul al}{\f41\fs24  der welde sw\'e6re.
\par \tab \tab \tab \tab der weisen barmen\'e6re,
\par \tab \tab \tab \tab hilf rechen disiu leit.
\par \tab \tab \tab \tab loeser \'fbz den s\'fcnden,
\par \tab \tab \tab 10\tab wir gern ze den swebenden \'fcnden.
\par \tab \tab \tab \tab uns mac d\'een geist enz\'fcnden,
\par \tab \tab \tab \tab wirt riuwic herze erkant.
\par \tab \tab \tab \tab d\'een bluot h\'e2t uns begozzen,
\par \tab \tab \tab \tab den himel \'fbf geslozzen,
\par \tab \tab \tab 15\tab n\'fb loeset unverdrozzen
\par \tab \tab \tab \tab daz h\'earebernde lant.
\par \tab \tab \tab \tab verzinset l\'eep und eigen,
\par \tab \tab \tab \tab got sol uns helfe erzeigen\tab 77,1
\par \tab \tab \tab \tab \'fbf den, der manigen veigen
\par \tab \tab \tab 20\tab der s\'eale h\'e2t gepfant.
\par 
\par \tab }{\b\f41\fs24 II\tab \tab \tab }{\f41\fs24 Diz kurze leben verswindet,\tab 77,4
\par \tab \tab \tab \tab der t\'f4t uns s\'fcndic vindet,
\par \tab \tab \tab \tab swer sich ze gote gesindet,
\par \tab \tab \tab \tab der mac der helle eng\'e2n.
\par \tab \tab \tab 5\tab b\'ee sw\'e6re ist gen\'e2de funden:
\par \tab \tab \tab \tab n\'fb heilent kristes wunden.
\par \tab \tab \tab \tab s\'een lant wirt schiere enbunden,
\par \tab \tab \tab \tab d\'east sicher sunder w\'e2n.
\par \tab \tab \tab \tab k\'fcnig\'een ob allen frowen,
\par \tab \tab \tab 10\tab l\'e2 werende helfe schowen.
\par \tab \tab \tab \tab d\'een kint wart dort verhowen,
\par \tab \tab \tab \tab s\'een menscheit sich ergap.
\par \tab \tab \tab \tab s\'een geist m\'fceze uns gefristen,
\par \tab \tab \tab \tab daz wir die diet verlisten.
\par \tab \tab \tab 15\tab der touf si seit unkristen,
\par \tab \tab \tab \tab wan f\'fcrhtent s\'ee den stap,
\par \tab \tab \tab \tab der ouch die juden villet?
\par \tab \tab \tab \tab ir schr\'eeen l\'fbt erhillet.
\par \tab \tab \tab \tab manic lop dem kriuze erschillet:
\par \tab \tab \tab 20\tab erloesen wir daz grap!
\par 
\par \tab }{\b\f41\fs24 III}{\f41\fs24 \tab \tab \tab Diu menscheit muoz verderben,\tab 77,24
\par \tab \tab \tab \tab suln wir den l\'f4n erwerben,
\par \tab \tab \tab \tab got wolde dur uns sterben,
\par \tab \tab \tab \tab s\'een dr\'f4 ist \'fbf gespart.
\par \tab \tab \tab 5\tab s\'een kriuze vil geh\'earet
\par \tab \tab \tab \tab h\'e2t maniges heil gem\'earet.
\par \tab \tab \tab \tab swer sich von zw\'eevel k\'earet,
\par \tab \tab \tab \tab der h\'e2t den geist bewart.
\par \tab \tab \tab \tab s\'fcndic l\'eep vergezzen,
\par \tab \tab \tab 10\tab dir sint diu j\'e2r gemezzen,
\par \tab \tab \tab \tab der t\'f4t h\'e2t uns besezzen
\par \tab \tab \tab \tab die veigen \'e2ne wer.
\par \tab \tab \tab \tab n\'fb hellent hin gel\'eeche,
\par \tab \tab \tab \tab daz wir daz himelr\'eeche
\par \tab \tab \tab 15\tab erwerben sicherl\'eeche
\par \tab \tab \tab \tab b\'ee duldekl\'eecher zer.
\par \tab \tab \tab \tab got wil mit heldes handen
\par \tab \tab \tab \tab dort rechen s\'eenen anden,\tab 78,1
\par \tab \tab \tab \tab sich schar von manigen landen
\par \tab \tab \tab 20\tab de}{\f41\fs24\ul s}{\f41\fs24  heilegeistes her!
\par 
\par \tab }{\b\f41\fs24 IV}{\f41\fs24 \tab \tab \tab Got, d\'een helfe uns sende,\tab 78,4
\par \tab \tab \tab \tab mit d\'eener zeswen hende
\par \tab \tab \tab \tab bewar uns an dem ende,
\par \tab \tab \tab \tab s\'f4 uns der geist verl\'e2t,
\par \tab \tab \tab 5\tab vor helleheizen wallen,
\par \tab \tab \tab \tab daz wir dar in iht vallen.
\par \tab \tab \tab \tab ez ist wol kunt uns allen,
\par \tab \tab \tab \tab wie j\'e2merl\'eech ez st\'e2t,
\par \tab \tab \tab \tab daz h\'eare lant vil reine,
\par \tab \tab \tab 10\tab gar helfel\'f4s und eine.
\par \tab \tab \tab \tab Ierusal\'eam, n\'fb weine,
\par \tab \tab \tab \tab wie d\'een vergezzen ist!
\par \tab \tab \tab \tab der heiden \'fcberh\'eare
\par \tab \tab \tab \tab h\'e2t dich verschelket s\'eare.
\par \tab \tab \tab 15\tab dur d\'eener namen \'eare
\par \tab \tab \tab \tab l\'e2 dich erbarmen, Krist,
\par \tab \tab \tab \tab mit welher n\'f4t si ringen,
\par \tab \tab \tab \tab die dort den borgen dingen,
\par \tab \tab \tab \tab daz si uns als\'f4 betwingen,
\par \tab \tab \tab 20\tab daz wende in kurzer frist.
\par 
