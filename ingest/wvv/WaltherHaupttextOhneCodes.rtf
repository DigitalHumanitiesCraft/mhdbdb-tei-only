\par \tab \tab C: I-XVII
\par 
\par }{\b\f41\fs24 I}{\f41\fs24 \tab \tab Der anegenge nie gewan\tab 78,24
\par \tab \tab und anegenge machen kan,
\par \tab \tab der kan wol ende machen und \'e2ne ende.
\par \tab \tab s\'eet daz allez st\'eat in s\'eener hende,
\par \tab 5\tab wer w\'e6re danne lobes s\'f4 wol wert?
\par \tab \tab der s\'ee der \'earste in m\'eener w\'ees}{\f41\fs24\ul e}{\f41\fs24 .
\par \tab \tab s\'een lop g\'eat }{\f41\fs24\ul vor}{\f41\fs24  allem pr\'ees}{\f41\fs24\ul e}{\f41\fs24 .
\par \tab \tab daz lop ist s\'e6lic, des er gert.
\par 
\par }{\b\f41\fs24 II}{\f41\fs24 \tab \tab N\'fb loben wir die s\'fcezen maget,\tab 78,32
\par \tab \tab der ir sun niemer niht versaget.
\par \tab \tab si ist des muoter, der von helle uns l\'f4ste.
\par \tab \tab daz ist uns ein tr\'f4st vor allem tr\'f4ste,
\par \tab 5\tab daz man d\'e2 ze himel ir willen tuot.
\par \tab \tab n\'fb dar, die alten mit den jungen,
\par \tab \tab daz ir werde lop gesungen.
\par \tab \tab si ist guot ze lobenne, s\'ee ist guot.
\par 
\par }{\b\f41\fs24 III}{\f41\fs24 \tab \tab Ich solt iuch engele gr\'fcezen ouch,\tab 79,1
\par \tab \tab wan daz ich bin niht gar ein gouch:
\par \tab \tab waz habt ir der heiden noch zerstoeret?
\par \tab \tab s\'eet iuch nieman siht noch nieman hoeret,
\par \tab 5\tab sagent, waz h\'e2nt ir noch dar zuo get\'e2n?
\par \tab \tab m\'f6hte ich got stille als ir gerechen,
\par \tab \tab mit we}{\f41\fs24\ul m}{\f41\fs24  solt ich mich besprechen?
\par \tab \tab ich wolte iuch h\'earren ruowen l\'e2n.
\par 
\par }{\b\f41\fs24 IV}{\f41\fs24 \tab \tab H\'ear Michah\'eal, h\'ear Gabr\'ee\'eal,\tab 79,9
\par \tab \tab h\'ear tiufels v\'eeent Raphah\'eal,
\par \tab \tab ir pflegent w\'eesheit, sterke und arzen\'eee.
\par \tab \tab dar zuo h\'e2nt ir engelkoere dr\'eee,
\par \tab 5\tab die mit willen leistent iuwer gebot.
\par \tab \tab welt ir m\'een lop, s\'f4 sint bescheiden
\par \tab \tab und schadent aller\'earst den heiden.
\par \tab \tab lopt ich iuch \'ea, daz w\'e6re ir spot.
\par 
\par 
\par }{\b\f41\fs24 V}{\f41\fs24 \tab \tab Man h\'f4hgem\'e2c, an friunden kranc,\tab 79,17
\par \tab \tab daz ist ein swacher habedanc,
\par \tab \tab baz hilfet friuntschaft \'e2ne sippe.
\par \tab \tab l\'e2 einen s\'een geborn von k\'fcniges rippe,
\par \tab 5\tab ern habe friunde, waz hilfet daz?
\par \tab \tab m\'e2gschaft ist ein selbwahsen \'eare,
\par \tab \tab s\'f4 muoz man friunde verdienen s\'eare.
\par \tab \tab m\'e2c hilfet wol, friunt verre baz.
\par 
\par 
\par }{\b\f41\fs24 VI}{\f41\fs24  \tab \tab Swer sich ze friunde gewinnen l\'e2t\tab 79,25
\par \tab \tab und ouch d\'e2 b\'ee die tugende h\'e2t,
\par \tab \tab daz er sich \'e2ne wanken l\'e2t behalten,
\par \tab \tab des friundes mac man gerne sch\'f4ne walten.
\par \tab 5\tab ich h\'e2n eteswenne friun}{\f41\fs24\ul t}{\f41\fs24  erkorn
\par \tab \tab s\'f4 sinewel an s\'eener st\'e6te,
\par \tab \tab swie gerne ich in behalten h\'e6te,
\par \tab \tab daz ich in m}{\f41\fs24\ul uo}{\f41\fs24 ste h\'e2n verlorn.
\par 
\par }{\b\f41\fs24 VII}{\f41\fs24 \tab \tab Swer mir ist slipfic als ein \'ees\tab 79,33
\par \tab \tab und mich \'fbf hebt in balles w\'ees,
\par \tab \tab sinewel}{\f41\fs24\ul le}{\f41\fs24  ich dem in s\'eenen handen,
\par \tab \tab daz sol zunst\'e6te nieman an mir anden,
\par \tab 5\tab s\'eet ich dem getriuwen friunde bin
\par \tab \tab einloetic unde wol gevieret.
\par \tab \tab swes muot mir ist s\'f4 v\'each gezieret, \tab 80,1
\par \tab \tab n\'fb sus, n\'fb s\'f4, dem walge ich hin.
\par 
\par 
\par }{\b\f41\fs24 VIII}{\f41\fs24 \tab \tab Sich wolte ein ses gesibent h\'e2n\tab 80,3
\par \tab \tab \'fbf einen h\'f4hvertigen w\'e2n,
\par \tab \tab sus strebte ez s\'eare n\'e2ch der \'fcberm\'e2ze.
\par \tab \tab swer der m\'e2ze brechen wil ir str\'e2ze,
\par \tab 5\tab dem gevellet l\'eehte ein enger pfat.
\par \tab \tab h\'f4hvertic ses, n\'fb sta}{\f41\fs24\ul n}{\f41\fs24 t gedr\'eeet!
\par \tab \tab dir was zem sese ein velt gefr\'eeet,
\par \tab \tab n\'fb smiuc dich an der dr\'eeen stat!
\par 
\par 
\par }{\b\f41\fs24 IX}{\f41\fs24 \tab \tab Swelh herre nieman niht versaget,\tab 80,11
\par \tab \tab der ist an gebender kunst verschraget,
\par \tab \tab der muoz iemer n\'f4tic s\'een alde triegen.
\par \tab \tab zehen versagen sint bezzer danne ein liegen.
\par \tab 5\tab geheize minre unde gr\'fceze baz,
\par \tab \tab welle er ze rehte umbe \'eare sorgen.
\par \tab \tab swes er niht m\'fcge \'fbz geborgen
\par \tab \tab noch selbe enhabe, versage doch daz.
\par 
\par 
\par }{\b\f41\fs24 X}{\f41\fs24 \tab \tab Unm\'e2ze, nim dich beider an:\tab 80,19
\par \tab \tab manl\'eechiu w\'eep, w\'eepl\'eech man,
\par \tab \tab pfafl\'eech ritter, ritterl\'eech pfaffen,
\par \tab \tab mit den solt d\'fb d\'eenen willen schaffen,
\par \tab 5\tab ich wil dir si gar ze stiure geben.
\par \tab \tab ich wil dir junge altherren zeigen
\par \tab \tab und alte jungherren geben f\'fcr eigen,
\par \tab \tab daz s\'ee dir twerhes helfen leben.
\par 
\par 
\par }{\b\f41\fs24 XI}{\f41\fs24 \tab \tab Den d\'eeemant, den edelen stein,\tab 80,35
\par \tab \tab gap mir der schoenesten ritter ein.
\par \tab \tab \'e2ne bete wart mir diu g\'e2be s\'eene.\tab 81,1
\par \tab \tab j\'f4 lob ich niht die schoene n\'e2ch dem sch\'eene:
\par \tab 5\tab milter man ist schoene und wol gezogen.
\par \tab \tab man sol die inre tugende \'fbz k\'earen,
\par \tab \tab s\'f4 ist daz \'fbzer lop n\'e2ch \'earen,
\par \tab \tab sam des von Katzenellenbogen.
\par 
\par 
\par }{\b\f41\fs24 XII}{\f41\fs24 \tab \tab Ich bin dem Bogen\'e6re holt\tab 80,27
\par \tab \tab gar \'e2ne g\'e2be und \'e2ne solt:
\par \tab \tab er ist milte, swie kleine ich s\'een geniuze,
\par \tab \tab s\'f4 nieze in aber ein P\'f4l\'e2n alder ein Riuze.
\par \tab 5\tab daz ist allez \'e2ne m\'eenen haz.
\par \tab \tab in br\'e6hte ein meister baz ze m\'e6re
\par \tab \tab danne t\'fbsent snarrenz\'e6re,
\par \tab \tab t\'e6t er den hovewerden baz.
\par 
\par 
\par }{\b\f41\fs24 XIII}{\f41\fs24 \tab \tab Wer sleht den lewen? wer sleht den risen?\tab 81,7
\par \tab \tab wer \'fcberwindet jenen und disen?
\par \tab \tab daz tuot jener, der sich selber twinget
\par \tab \tab und alliu s\'eeniu lit in huote bringet
\par \tab 5\tab \'fbz der wilde in st\'e6ter z\'fchte habe.
\par \tab \tab geligeniu zuht und schame vor gesten
\par \tab \tab mugen wol ein w\'eele erglesten.
\par \tab \tab der sch\'een nimt dr\'e2te \'fbf und abe.
\par 
\par 
\par }{\b\f41\fs24 XIV}{\f41\fs24 \tab \tab Wolveile unwirdet manigen l\'eep.\tab 81,15
\par \tab \tab ir werden man, ir reiniu w\'eep,
\par \tab \tab niht ens\'eet durch kranke miete veile.
\par \tab \tab ez muoz s\'eare st\'ean an iuwerm heile,
\par \tab 5\tab welt ir iuch vergeben vinden l\'e2n.
\par \tab \tab zundanke wolveile unwirdet s\'eare.
\par \tab \tab d\'e2 b\'ee s\'f4 swachet iuwer \'eare
\par \tab \tab und ziuhet doch \'fbf sm\'e6hen w\'e2n.
\par 
\par 
\par }{\b\f41\fs24 XV}{\f41\fs24 \tab \tab Swelh man wirt \'e2ne muot ze rich\tab 81,23
\par \tab \tab wil er ze s\'eare striuzen sich
\par \tab \tab \'fbf s\'eene r\'eechheit, s\'f4 wirt er ze h\'eare.
\par \tab \tab ze r\'eech und ze arn, die leschent beide s\'eare
\par \tab 5\tab an sumel\'eechen liuten rehten muot.
\par \tab \tab sw\'e2 \'fcbric r\'eecheit z\'fchte slucket
\par \tab \tab und \'fcbric armuot sinne zucket,
\par \tab \tab d\'e2 dunket mich enwederz guot.
\par 
\par 
\par }{\b\f41\fs24 XVI}{\f41\fs24 \tab \tab Diu minne ist weder man noch w\'eep,\tab 81,31
\par \tab \tab si h\'e2t noch s\'eale noch den l\'eep,
\par \tab \tab s\'ee gel\'eechet sich dekeinem bilde.
\par \tab \tab ir nam ist kunt, si selbe ist aber wilde,
\par \tab 5\tab und enkan doch nieman \'e2ne sie
\par \tab \tab der gotes hulden niht gewinnen
\par \tab \tab [. . . . . . . . .]\tab 82,1
\par \tab \tab si kam in valschez herze nie.
\par 
\par 
\par }{\b\f41\fs24 XVII}{\f41\fs24 \tab \tab Ez ist in unsern kurzen tagen\tab 82,3
\par \tab \tab n\'e2ch minne valsches vil geslagen.
\par \tab \tab swer aber ir insigel rehte erkande,
\par \tab \tab dem setze ich m\'eene w\'e2rheit des ze pfande,
\par \tab 5\tab wolt er ir geleite volgen mite,
\par \tab \tab daz in unfuoge niht ersl\'fcege.
\par \tab \tab minne ist ze himel s\'f4 gef\'fcege,
\par \tab \tab daz ich si dar geleites bite.
\par 
\par 
