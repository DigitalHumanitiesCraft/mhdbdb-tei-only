# TEI/XML files should preserve original encoding and line endings
*.xml -text
*.tei.xml -text

# Committed TEI P5 schema (external, pinned): force LF for deterministic builds.
# Specific path only — NOT *.rng, so the generated mhdbdb*.rng drift check is untouched.
schema/tei_all.rng text eol=lf

# Text files with proper normalization
*.md text=auto
*.js text=auto
*.css text=auto
*.html text=auto
*.json text=auto
*.yml text=auto
*.yaml text=auto

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.gz binary
*.json.gz binary

# Generated by scripts/build-begriffshilfe.py, which writes LF. Under
# core.autocrlf=true the checkout was CRLF, so after every rebuild the file
# differed in size from the index and showed as modified although its content
# was unchanged (measured 2026-10-07). With eol=lf the checkout is LF as well;
# an existing CRLF checkout settles after one `git restore` of the file.
assets/downloads/mhdbdb-begriffshilfe.md text eol=lf
