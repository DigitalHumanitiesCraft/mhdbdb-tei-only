        <org xml:id="mhdbdb-team">
          <orgName xml:lang="de">MHDBDB-Team</orgName>
          <desc xml:lang="de">Alle Mitwirkenden der Mittelhochdeutschen Begriffsdatenbank — Gründer, Koordination und Editor:innen. Dient als Verweis-Anker für die kollektive Team-Attribution in den Korpus-Headern via orgName/@ref auf contributors.xml#mhdbdb-team.</desc>
        </org>
        <org xml:id="dhcraft">
          <orgName xml:lang="de">Digital Humanities Craft</orgName>
          <desc xml:lang="de">Digital-Humanities-Dienstleister mit Sitz in Graz, verantwortlich für technische Umsetzung, Grafikdesign und Webentwicklung der MHDBDB.</desc>
          <idno type="URL">https://dhcraft.org</idno>
        </org>
