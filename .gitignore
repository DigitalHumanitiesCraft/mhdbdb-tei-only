# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Note: package-lock.json should be committed for reproducible builds

# Testing and development (keep testing code, ignore results)
test-results/
screenshots/
testing/test-results/
testing/test-summary.txt
testing/tests/*.json
testing/tests/*.png
testing/screenshots/

# Proposals (secret)
proposals/

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# IDE and editor files
# .vscode/
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.code-workspace

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Logs
*.log
logs/

# Runtime and temporary files
.tmp/
*.pid

# POS disambiguation temp files (entire folder ignored)
\temp
*.seed
*.pid.lock

# Build outputs
dist/
build/
out/

# Environment files
.env
.env.local
.env.development
.env.test
.env.production

# GitHub specific (keep workflows but ignore local artifacts)
# Note: workflows should be tracked, not ignored

# Backup files
*.bak
*.backup
__pycache__/

# Zotero API cache
scripts/sync/.zotero_cache.json

# Audit script outputs (regenerated on each run)
scripts/audit/*.json
scripts/audit/*-REPORT.md
docs/research/*.json

# Debug and manual test files
nul
testing/manual-*.html
testing/test-debug.html
schema/tei_all.rng

# Source-ZIPs in Ingest-Ordnern (Original-Daten von Beitragenden, untracked)
ingest/**/*.zip
